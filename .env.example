# local uses SQLite; supabase uses the authenticated cloud data source.
THOUGHT_SPACE_MODE=supabase
THOUGHT_SPACE_LOCAL_DB=.thought-space.sqlite
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used when packaging Electron; points at the deployed Thought Space app.
THOUGHT_SPACE_API_ORIGIN=
ASSEMBLYAI_API_KEY=
DEEPSEEK_API_KEY=
# Public guest mode: anonymous Supabase identity, no login screen.
NEXT_PUBLIC_THOUGHT_SPACE_GUEST_MODE=false

# Public GitHub Release installer delivery. Set this only on the web host.
DESKTOP_RELEASE_URL=
