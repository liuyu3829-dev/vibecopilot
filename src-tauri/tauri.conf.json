{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thought Space Orb",
  "version": "0.1.6",
  "identifier": "com.thoughtspace.orb",
  "build": { "frontendDist": "../public" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["thoughtspace"] } }
  }
}
